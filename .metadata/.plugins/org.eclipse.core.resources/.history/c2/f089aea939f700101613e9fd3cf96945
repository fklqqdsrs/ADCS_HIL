/**
 * @brief Configures the CAN filter to accept ALL incoming messages.
 * @param hcan: Pointer to CAN handle (e.g., &hcan1)
 */
void CAN_Filter(CAN_HandleTypeDef *hcan) {
    CAN_FilterTypeDef  sFilterConfig;

    // Filter Bank: 0 to 13 for most STM32s (14 to 27 for Connectivity Line/Dual CAN)
    sFilterConfig.FilterBank = 0;

    // Mode: Mask Mode (Id & Mask)
    sFilterConfig.FilterMode = CAN_FILTERMODE_IDMASK;

    // Scale: Single 32-bit filter (covers both Std and Ext IDs)
    sFilterConfig.FilterScale = CAN_FILTERSCALE_32BIT;

    // Filter ID: 0x0000 (Base ID to match)
    sFilterConfig.FilterIdHigh = 0x0000;
    sFilterConfig.FilterIdLow = 0x0000;

    // Filter Mask: 0x0000 (0 means "don't care" about any bit)
    sFilterConfig.FilterMaskIdHigh = 0x0000;
    sFilterConfig.FilterMaskIdLow = 0x0000;

    // Assign to FIFO 0 (can be CAN_FILTER_FIFO0 or CAN_FILTER_FIFO1)
    sFilterConfig.FilterFIFOAssignment = CAN_FILTER_FIFO0;

    // Activate the filter
    sFilterConfig.FilterActivation = CAN_FILTER_ENABLE;

    // If using Dual CAN (e.g., STM32F4/F7), SlaveStartFilterBank defines
    // where CAN2's filters begin. 14 is the default.
    sFilterConfig.SlaveStartFilterBank = 14;

    if (HAL_CAN_ConfigFilter(hcan, &sFilterConfig) != HAL_OK) {
        /* Filter configuration Error */
        Error_Handler();
    }
}

