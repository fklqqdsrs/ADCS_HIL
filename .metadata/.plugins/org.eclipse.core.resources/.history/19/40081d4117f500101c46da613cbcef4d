/* Includes ------------------------------------------------------------------*/
#include "lwip/opt.h"

#if LWIP_NETCONN

#include "lwip/api.h"
#include "lwip/sys.h"

#include "hil_config.h"
#include "hil_sensor_emulator.h"

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
#define HIL_UDP_THREAD_PRIO  ( tskIDLE_PRIORITY + 4 )
#define HIL_UDP_PORT 7
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
volatile uint32_t g_hil_udp_rx_count = 0U;
volatile uint32_t g_hil_udp_copy_err_count = 0U;
volatile uint32_t g_hil_udp_update_call_count = 0U;
/* Private function prototypes -----------------------------------------------*/
static void udpecho_thread(void *arg);
void udpecho_init(void);

/*-----------------------------------------------------------------------------------*/
static void udpecho_thread(void *arg)
{
  err_t err = ERR_OK;
  struct netconn *conn = NULL;

  LWIP_UNUSED_ARG(arg);

  conn = netconn_new(NETCONN_UDP);
  if (conn != NULL)
  {
    err = netconn_bind(conn, IP_ADDR_ANY, HIL_UDP_PORT);
    if (err == ERR_OK)
    {
      for (;;)
      {
        struct netbuf *buf = NULL;
        err_t recv_err = netconn_recv(conn, &buf);

        if (recv_err == ERR_OK)
        {
          ++g_hil_udp_rx_count;
          u16_t buf_len = netbuf_len(buf);

          if (buf_len == HIL_PACKET_BYTES)
          {
            uint8_t payload[HIL_PACKET_BYTES];
            u16_t copied = netbuf_copy(buf, payload, HIL_PACKET_BYTES);

            if (copied == HIL_PACKET_BYTES)
            {
              ++g_hil_udp_update_call_count;
              hil_sensor_emulator_update_from_payload(payload, sizeof(payload));
            }
            else
            {
              ++g_hil_udp_copy_err_count;
            }
          }

          netbuf_delete(buf);
        }
      }
    }
    else
    {
      netconn_delete(conn);
    }
  }
}
/*-----------------------------------------------------------------------------------*/
void udpecho_init(void)
{
  sys_thread_new("udpecho_thread", udpecho_thread, NULL, DEFAULT_THREAD_STACKSIZE, HIL_UDP_THREAD_PRIO);
}

#endif /* LWIP_NETCONN */
