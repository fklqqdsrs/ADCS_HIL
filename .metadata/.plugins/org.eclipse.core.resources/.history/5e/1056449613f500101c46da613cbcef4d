/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
#define UDPECHO_THREAD_PRIO  ( tskIDLE_PRIORITY + 4 )
#define HIL_UDP_PORT 7
#define HIL_PACKET_DOUBLES 31U
#define HIL_PACKET_BYTES 248U
#define HIL_SUN_SENSOR_COUNT 6U
#define HIL_SUN_VECTOR_SIZE 3U

#ifndef HIL_DOUBLE_BIG_ENDIAN
#define HIL_DOUBLE_BIG_ENDIAN 0
#endif
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
typedef struct
{
  double gyro[3];
  double mag[3];
  double ecef_pos[3];
  double ecef_vel[3];
  double unix_time;
  double sun[HIL_SUN_SENSOR_COUNT][HIL_SUN_VECTOR_SIZE];
} HilPacket;

/* Private function prototypes -----------------------------------------------*/
static void udpecho_thread(void *arg);
static uint64_t hil_read_u64(const uint8_t *src);
static double hil_read_double(const uint8_t *src);
static bool hil_parse_payload(const uint8_t *payload, size_t len, HilPacket *out);
static void hil_apply_packet(const HilPacket *packet);
static void imu_emulator_update(const double gyro[3]);
static void mag_emulator_update(const double mag[3]);
static void gnss_emulator_update(const double ecef_pos[3], const double ecef_vel[3], double unix_time);
static void fss_emulator_update(uint32_t sensor_index, const double sun_vec[3]);
void udpecho_init(void);

static uint64_t hil_read_u64(const uint8_t *src)
{
#if HIL_DOUBLE_BIG_ENDIAN
  return ((uint64_t)src[0] << 56) |
         ((uint64_t)src[1] << 48) |
         ((uint64_t)src[2] << 40) |
         ((uint64_t)src[3] << 32) |
         ((uint64_t)src[4] << 24) |
         ((uint64_t)src[5] << 16) |
         ((uint64_t)src[6] << 8) |
         ((uint64_t)src[7]);
#else
  return ((uint64_t)src[0]) |
         ((uint64_t)src[1] << 8) |
         ((uint64_t)src[2] << 16) |
         ((uint64_t)src[3] << 24) |
         ((uint64_t)src[4] << 32) |
         ((uint64_t)src[5] << 40) |
         ((uint64_t)src[6] << 48) |
         ((uint64_t)src[7] << 56);
#endif
}

static double hil_read_double(const uint8_t *src)
{
  uint64_t raw = hil_read_u64(src);
  double value = 0.0;

  memcpy(&value, &raw, sizeof(value));
  return value;
}

static bool hil_parse_payload(const uint8_t *payload, size_t len, HilPacket *out)
{
  size_t offset = 0U;
  size_t i = 0U;
  size_t j = 0U;

  if ((payload == NULL) || (out == NULL))
  {
    return false;
  }

  if (len != HIL_PACKET_BYTES)
  {
    return false;
  }

  if (sizeof(double) != 8U)
  {
    return false;
  }

  for (i = 0U; i < 3U; ++i)
  {
    out->gyro[i] = hil_read_double(payload + offset);
    offset += 8U;
  }

  for (i = 0U; i < 3U; ++i)
  {
    out->mag[i] = hil_read_double(payload + offset);
    offset += 8U;
  }

  for (i = 0U; i < 3U; ++i)
  {
    out->ecef_pos[i] = hil_read_double(payload + offset);
    offset += 8U;
  }

  for (i = 0U; i < 3U; ++i)
  {
    out->ecef_vel[i] = hil_read_double(payload + offset);
    offset += 8U;
  }

  out->unix_time = hil_read_double(payload + offset);
  offset += 8U;

  for (i = 0U; i < HIL_SUN_SENSOR_COUNT; ++i)
  {
    for (j = 0U; j < HIL_SUN_VECTOR_SIZE; ++j)
    {
      out->sun[i][j] = hil_read_double(payload + offset);
      offset += 8U;
    }
  }

  return (offset == HIL_PACKET_BYTES);
}

static void hil_apply_packet(const HilPacket *packet)
{
  uint32_t i = 0U;

  if (packet == NULL)
  {
    return;
  }

  imu_emulator_update(packet->gyro);
  mag_emulator_update(packet->mag);
  gnss_emulator_update(packet->ecef_pos, packet->ecef_vel, packet->unix_time);

  for (i = 0U; i < HIL_SUN_SENSOR_COUNT; ++i)
  {
    fss_emulator_update(i, packet->sun[i]);
  }
}

static void imu_emulator_update(const double gyro[3])
{
  (void)gyro;
}

static void mag_emulator_update(const double mag[3])
{
  (void)mag;
}

static void gnss_emulator_update(const double ecef_pos[3], const double ecef_vel[3], double unix_time)
{
  (void)ecef_pos;
  (void)ecef_vel;
  (void)unix_time;
}

static void fss_emulator_update(uint32_t sensor_index, const double sun_vec[3])
{
  (void)sensor_index;
  (void)sun_vec;
}

/*-----------------------------------------------------------------------------------*/
static void udpecho_thread(void *arg)
{
  err_t err = ERR_OK;
  struct netconn *conn = NULL;

  LWIP_UNUSED_ARG(arg);

  conn = netconn_new(NETCONN_UDP);
  if (conn != NULL)
  {
    err = netconn_bind(conn, IP_ADDR_ANY, HIL_UDP_PORT);
    if (err == ERR_OK)
    {
      for (;;)
      {
        struct netbuf *buf = NULL;
        err_t recv_err = netconn_recv(conn, &buf);

        if (recv_err == ERR_OK)
        {
          u16_t buf_len = netbuf_len(buf);

          if (buf_len == HIL_PACKET_BYTES)
          {
            uint8_t payload[HIL_PACKET_BYTES];
            HilPacket packet;

            if (netbuf_copy(buf, payload, HIL_PACKET_BYTES) == ERR_OK)
            {
              if (hil_parse_payload(payload, sizeof(payload), &packet))
              {
                hil_apply_packet(&packet);
              }
            }
          }

          netbuf_delete(buf);
        }
      }
    }
    else
    {
      netconn_delete(conn);
    }
  }
}
/*-----------------------------------------------------------------------------------*/
void udpecho_init(void)
{
  sys_thread_new("udpecho_thread", udpecho_thread, NULL, DEFAULT_THREAD_STACKSIZE,UDPECHO_THREAD_PRIO );
}

