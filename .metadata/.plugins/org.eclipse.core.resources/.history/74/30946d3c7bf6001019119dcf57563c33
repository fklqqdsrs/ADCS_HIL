void hil_sensor_emulator_update_from_payload(const uint8_t *payload, size_t len)
{


  if ((payload == NULL) || (len != HIL_PACKET_BYTES))
  {
    return;
  }

  if (sizeof(double) != HIL_DOUBLE_BYTES)
  {
    return;
  }

#if (HIL_ROLE == HIL_ROLE_IMU)
  {
    size_t offset = HIL_GYRO_OFFSET;
    double gyro[3];
    uint32_t i = 0U;

    for (i = 0U; i < 3U; ++i)
    {
      gyro[i] = hil_read_double(payload + offset);
      offset += HIL_DOUBLE_BYTES;
    }
    hil_cache_write_imu(gyro);
  }
#elif (HIL_ROLE == HIL_ROLE_MAG)
  {
    size_t offset = HIL_MAG_OFFSET;
    double mag[3];
    uint32_t i = 0U;

    for (i = 0U; i < 3U; ++i)
    {
      mag[i] = hil_read_double(payload + offset);
      offset += HIL_DOUBLE_BYTES;
    }
    hil_cache_write_mag(mag);
  }
#elif (HIL_ROLE == HIL_ROLE_GNSS)
  {
    size_t offset = HIL_GNSS_OFFSET;
    double ecef_pos[3];
    double ecef_vel[3];
    double unix_time = 0.0;
    uint32_t i = 0U;

    for (i = 0U; i < 3U; ++i)
    {
      ecef_pos[i] = hil_read_double(payload + offset);
      offset += HIL_DOUBLE_BYTES;
    }
    for (i = 0U; i < 3U; ++i)
    {
      ecef_vel[i] = hil_read_double(payload + offset);
      offset += HIL_DOUBLE_BYTES;
    }
    unix_time = hil_read_double(payload + offset);
    hil_cache_write_gnss(ecef_pos, ecef_vel, unix_time);
  }
#elif (HIL_ROLE >= HIL_ROLE_FSS1) && (HIL_ROLE <= HIL_ROLE_FSS6)
  {
    const uint32_t sun_index = (uint32_t)(HIL_ROLE - HIL_ROLE_FSS1);
    size_t offset = HIL_SUN_OFFSET + (sun_index * HIL_SUN_STRIDE);
    double sun_vec[3];
    uint32_t i = 0U;

    for (i = 0U; i < 3U; ++i)
    {
      sun_vec[i] = hil_read_double(payload + offset);
      offset += HIL_DOUBLE_BYTES;
    }
    hil_cache_write_fss(sun_vec);
  }
#else
  (void)payload;
  (void)len;
#endif
}

