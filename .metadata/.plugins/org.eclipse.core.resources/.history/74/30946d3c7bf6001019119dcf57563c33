#if (HIL_ROLE == HIL_ROLE_IMU)
static void hil_imu_task(void *arg)
{
  TickType_t last_wake = xTaskGetTickCount();
  const TickType_t period = pdMS_TO_TICKS(1000U / HIL_IMU_RATE_HZ);
  double gyro[3] = {0.0, 0.0, 0.0};

  (void)arg;

  for (;;)
  {
    vTaskDelayUntil(&last_wake, period);
    hil_cache_read_imu(gyro);
    hil_imu_tx_rs422(gyro);
  }
}

static void hil_imu_tx_rs422(const double gyro[3])
{
  (void)gyro;
  msg.header = 0x55FF81FE;
  msg.data.temp = 40;
  msg.data.seq = 0;
  msg.data.status = 119;

  msg.data.Xrot = (float)gyro[0];
  msg.data.Yrot = (float)gyro[1];
  msg.data.Zrot = (float)gyro[2];


//  reverse_bytes((uint8_t*)&gyro_f[0],(uint8_t *)&msg.data.Xrot, 4);
//  reverse_bytes((uint8_t*)&gyro_f[1],(uint8_t *)&msg.data.Yrot, 4);
//  reverse_bytes((uint8_t*)&gyro_f[2],(uint8_t *)&msg.data.Zrot, 4);
  uint32_t crc = calculate_crc32((uint8_t *)&msg.data,sizeof(message_data_format_t));
  reverse_bytes((uint8_t *)&crc,(uint8_t *)&msg.crc, 4);

  HAL_UART_Transmit(&huart3,(uint8_t*)&msg,sizeof(message_format_t), 100);
  msg.data.seq++;
  if(msg.data.seq == 127)
  {

	  msg.data.seq = 0;
  }
}
#endif

#if (HIL_ROLE == HIL_ROLE_GNSS)
static void hil_gnss_task(void *arg)
{
  TickType_t last_wake = xTaskGetTickCount();
  const TickType_t period = pdMS_TO_TICKS(1000U / HIL_GNSS_RATE_HZ);
  double ecef_pos[3] = {0.0, 0.0, 0.0};
  double ecef_vel[3] = {0.0, 0.0, 0.0};
  double unix_time = 0.0;

  (void)arg;

  for (;;)
  {
    vTaskDelayUntil(&last_wake, period);
    hil_cache_read_gnss(ecef_pos, ecef_vel, &unix_time);
    hil_gnss_tx_can(ecef_pos, ecef_vel, unix_time);
  }
}

static void hil_gnss_tx_can(const double ecef_pos[3], const double ecef_vel[3], double unix_time)
{
  (void)ecef_pos;
  (void)ecef_vel;
  (void)unix_time;
}
