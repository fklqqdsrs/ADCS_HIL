static uint64_t hil_read_u64(const uint8_t *src)
{
#if HIL_DOUBLE_BIG_ENDIAN
  return ((uint64_t)src[0] << 56) |
         ((uint64_t)src[1] << 48) |
         ((uint64_t)src[2] << 40) |
         ((uint64_t)src[3] << 32) |
         ((uint64_t)src[4] << 24) |
         ((uint64_t)src[5] << 16) |
         ((uint64_t)src[6] << 8) |
         ((uint64_t)src[7]);
#else
  return ((uint64_t)src[0]) |
         ((uint64_t)src[1] << 8) |
         ((uint64_t)src[2] << 16) |
         ((uint64_t)src[3] << 24) |
         ((uint64_t)src[4] << 32) |
         ((uint64_t)src[5] << 40) |
         ((uint64_t)src[6] << 48) |
         ((uint64_t)src[7] << 56);
#endif
}

static double hil_read_double(const uint8_t *src)
{
  uint64_t raw = hil_read_u64(src);
  double value = 0.0;

  memcpy(&value, &raw, sizeof(value));
  return value;
}

