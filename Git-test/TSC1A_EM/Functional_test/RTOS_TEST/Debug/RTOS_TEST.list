080150a8 <get_bits>:
void set_bits(uint32_t *data, uint32_t value, uint8_t start, uint8_t length) {
	uint32_t mask = ((1U << length) - 1) << start;
	*data = (*data & ~mask) | ((value << start) & mask);
}

